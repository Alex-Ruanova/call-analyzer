# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/altur

# Redis
REDIS_URL=redis://redis:6379/0

# OpenAI
OPENAI_API_KEY=sk-...

# Storage (absolute path inside container)
AUDIO_STORAGE_DIR=/app/storage/audio

# LLM model selection per stage
LLM_MODEL_TAGGING=gpt-4o-mini
LLM_MODEL_MOOD=gpt-4o-mini
LLM_MODEL_INSIGHTS=gpt-4o-mini
LLM_MODEL_SYNTHESIS=gpt-4o-mini
STT_MODEL=gpt-4o-transcribe-diarize

# Cost protection (all optional)
AUTH_ENABLED=false
API_KEY=
DAILY_BUDGET_USD=10.0
RATE_LIMIT_UPLOADS_PER_HOUR=10
ALLOWED_ORIGINS=http://localhost:5173

# Frontend (build arg)
VITE_API_BASE_URL=/api
VITE_API_KEY=

# Runtime environment
ENV=development
